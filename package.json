{
  "name": "toko-myrex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test",
    "test": "bun test",
    "verify": "bun run check && bun run build",
    "catalog:cleanup-uploads": "bun --conditions=react-server scripts/cleanup-product-uploads.ts",
    "auth:generate": "auth generate --config lib/auth/cli.ts --output lib/db/schema/auth.ts --yes",
    "auth:create-admin": "auth create-admin --config lib/auth/cli.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@base-ui/react": "^1.7.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "21.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "resend": "^6.22.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
